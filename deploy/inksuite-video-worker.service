[Unit]
Description=InkSuite video rendering worker
After=network.target
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/inksuite/app
EnvironmentFile=/etc/inksuite-api.env
ExecStart=/home/ubuntu/inksuite/app/.venv/bin/python -m app.video.worker
Restart=on-failure
RestartSec=5
MemoryMax=3G
TasksMax=64
Nice=10
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
