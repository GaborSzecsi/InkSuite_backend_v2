[Unit]
Description=InkSuite Marketing social publishing worker
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/inksuite/app
EnvironmentFile=/etc/inksuite-api.env
ExecStart=/home/ubuntu/inksuite/app/.venv/bin/python -m app.marketing.worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
